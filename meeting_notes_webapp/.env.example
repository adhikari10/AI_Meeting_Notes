# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# ── Deployment mode ──────────────────────────────────────────────
# true  = upload/URL-only, for servers with no audio hardware (skips
#         PyAudio, local Whisper, live-recording UI/socket handlers).
# false = full desktop behaviour (live mic/speaker recording).
CLOUD_MODE=false

# ── Server binding ───────────────────────────────────────────────
# Hosting platforms (Render, Railway, Fly, etc.) assign PORT — the app
# must listen on whatever it's given, not a hardcoded port.
HOST=0.0.0.0
PORT=5000

# Flask/Werkzeug debug mode. NEVER true in a publicly reachable
# deployment — it exposes the interactive debugger (arbitrary code
# execution for anyone who can trigger a stack trace). Fine to set
# true for local desktop development only.
FLASK_DEBUG=false

# ── Sessions ──────────────────────────────────────────────────────
# Effectively mandatory in cloud deployment. Without it, each process
# generates its own random key at boot, so signed sessions break
# across restarts and across gunicorn workers. Generate with e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"`.
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# ── Storage ───────────────────────────────────────────────────────
# Max upload size in megabytes.
MAX_UPLOAD_MB=500
# Optional overrides — default to <app>/uploads and <app>/notes.
# Set these if your platform mounts a persistent volume at a fixed path.
# UPLOAD_FOLDER=/data/uploads
# NOTES_FOLDER=/data/notes

# ── AI providers ──────────────────────────────────────────────────
# At least one of these is required; GROQ_API_KEY is the default provider.
GROQ_API_KEY=your-groq-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
# DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Which provider/model to use by default.
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile

# ── Transcription ─────────────────────────────────────────────────
# Local Whisper model size (desktop/live-mic path only; ignored when
# CLOUD_MODE=true). One of: tiny, base, small, medium, large.
WHISPER_MODEL=base

# Chunk size (bytes) for Groq file-transcription upload chunking.
# GROQ_TRANSCRIBE_CHUNK_BYTES=25000000
